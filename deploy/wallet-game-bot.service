# wallet-game grid bot (Level 2). A systemd user unit on the bot machine, kept apart from
# system-level trading-bot: different user, different name, files under ~ only.
# Install: see deploy/README.md. Going live = change WALLET_GAME_MODE below to live.
[Unit]
Description=wallet-game: Level 2 grid bot (one run)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/Personal/claude-game
Environment=WALLET_GAME_MODE=paper
ExecStart=/usr/bin/node src/bot.js
TimeoutStartSec=5min
# Stay out of the way of the trading-bot: small memory cap, low CPU and IO priority.
MemoryMax=256M
CPUWeight=20
Nice=10
IOSchedulingClass=idle
SyslogIdentifier=wallet-game-bot
